<Window x:Class="MetalCalcWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:MetalCalcWPF.Infrastructure"
        Title="Управление цехом (Laser Manager)" Height="720" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:ProfileKindDisplayConverter x:Key="KindRu"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value>
                        <ControlTemplate>
                            <DockPanel>
                                <Border BorderBrush="Red" BorderThickness="1">
                                    <AdornedElementPlaceholder/>
                                </Border>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="true">
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,10,0">
            <!--
                Структура левой панели:
                Row 0 — верхние системные кнопки («🗄 База данных» / «⚙ Настройки»), всегда видимы.
                Row 1 — ScrollViewer со всем редактируемым содержимым (поля ввода, вкладки, кнопка расчёта,
                        итог, «🔍 Детализация расчёта»).

                Скролл появляется автоматически, когда контент не помещается
                (VerticalScrollBarVisibility="Auto"). Горизонтальный — на случай очень узкого окна.
                Это решает проблему: при раскрытой детализации нижняя часть панели уезжала за край окна.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="🗄️ База данных" Command="{Binding OpenDatabaseCommand}" Margin="0,0,5,0" Padding="5,2" Background="#FFF0F0F0"/>
                    <Button Content="⚙ Настройки" Command="{Binding OpenSettingsCommand}" Padding="5,2"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="0,0,5,0">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Клиент / Название заказа:" FontWeight="Bold"/>
                    <TextBox Height="25" Margin="0,5,0,5" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Материал:" FontWeight="Bold" Margin="0,5,0,0"/>
                    <ComboBox Height="25" Margin="0,5,0,5"
                              ItemsSource="{Binding Materials}"
                              SelectedItem="{Binding SelectedMaterial}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Толщина (мм):" FontWeight="Bold"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="мм" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Количество (шт):" FontWeight="Bold"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="шт" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ✅ Переключатель режима: лист или сортамент проката -->
                    <CheckBox Content="📦 Сортамент проката (уголок / труба / швеллер / двутавр)"
                              IsChecked="{Binding UseRolledProfile}"
                              FontWeight="Bold" Margin="0,10,0,0"/>

                    <!-- Панель выбора профиля проката (видна только в режиме сортамента) -->
                    <StackPanel Visibility="{Binding UseRolledProfile, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Поиск по размеру / ГОСТ:" FontWeight="Bold" Margin="0,8,0,0"/>
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Height="25" Grid.Column="0"
                                     Text="{Binding RolledSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Напр. «50x50», «№14», «8509»"/>
                            <Button Grid.Column="1" Content="✕" Width="25" Height="25" Margin="3,0,0,0"
                                    ToolTip="Очистить поиск"
                                    Command="{Binding ClearRolledSearchCommand}"/>
                        </Grid>

                        <TextBlock Text="Профиль:" FontWeight="Bold" Margin="0,5,0,0"/>
                        <ComboBox Height="25" Margin="0,5,0,5" MaxDropDownHeight="400"
                                  ItemsSource="{Binding RolledProfilesView}"
                                  SelectedItem="{Binding SelectedRolledProfile}"
                                  IsTextSearchEnabled="True"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" Padding="6,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="Bold" Foreground="#E65100"
                                                               Text="{Binding Name, Converter={StaticResource KindRu}}"/>
                                                    <TextBlock Foreground="#9E9E9E" Margin="6,0,0,0">
                                                        (<Run Text="{Binding ItemCount, Mode=OneWay}"/>)
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <TextBlock Text="Длина одной заготовки (м):" FontWeight="Bold"/>
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Height="25" Grid.Column="0"
                                     Text="{Binding LengthMeterText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="м" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                        </Grid>
                        <TextBlock Text="{Binding RolledInfoText}"
                                   FontSize="11" Foreground="#1976D2" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    </StackPanel>

                    <!-- Панель «лист»: габариты + масса. Скрывается в режиме сортамента. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseRolledProfile}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                    <TextBlock Text="Габариты одной детали (мм):" FontWeight="Bold" Margin="0,10,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ширина X:" FontSize="10" Foreground="Gray"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="мм" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Bottom" Margin="10,0,10,5" FontWeight="Bold"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Высота Y:" FontSize="10" Foreground="Gray"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="мм" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Масса (кг):" FontWeight="Bold" Margin="0,10,0,0"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="25" Grid.Column="0" Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                        <TextBlock Grid.Column="1" Text="кг" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                    <TextBlock Text="Если известна масса партии, укажите её — габариты можно оставить пустыми."
                               FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <TabControl Grid.Row="1" Margin="0,0,0,10">
                    <TabItem Header="🔥 Лазер">
                        <StackPanel Margin="10">
                            <!-- ✅ Спринт 2.2b: выбор конкретного лазерного станка.
                                 Блок скрыт, если в справочнике нет активных лазеров —
                                 тогда расчёт идёт по чистой Excel-формуле без Setup/MinCharge. -->
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding HasLaserMachines, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Станок:" FontWeight="Bold"/>
                                <ComboBox Height="25" Margin="0,5,0,0"
                                          ItemsSource="{Binding LaserMachines}"
                                          SelectedItem="{Binding SelectedLaserMachine}"
                                          DisplayMemberPath="Name"
                                          ToolTip="Влияет на Setup / MinCharge / PricePerMeterOverride из справочника станков"/>
                            </StackPanel>

                            <TextBlock Text="Длина контура:"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding LaserLengthText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="м" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                            
                            <!-- ✅ НОВОЕ ПОЛЕ -->
                            <TextBlock Text="Количество отверстий (пробивок):"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding PiercesCountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="шт" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                            
                            <TextBlock Text="Длина реза одной детали + количество пробивок влияют на стоимость" 
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="📐 Гибка">
                        <StackPanel Margin="10">
                            <CheckBox Content="Учитывать гибку в расчете" IsChecked="{Binding UseBending}" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Количество гибов (на 1 деталь):"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding BendsCountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="шт" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>

                            <TextBlock Text="Длина линии гиба:"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding BendLengthText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="мм" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                            <TextBlock Text="Влияет на стоимость (до 1.5м / до 3м / до 6м)" FontSize="10" Foreground="Gray" Margin="0,-5,0,10"/>

                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="5" Background="#F0F0F0" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Техническая информация:" FontWeight="Bold" FontSize="10"/>
                                    <TextBlock Text="Выберите толщину..." FontSize="11" Foreground="Blue"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="🏗️ Сварка">
                        <StackPanel Margin="10">
                            <TextBlock Text="Длина шва:"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="25" Grid.Column="0" Text="{Binding WeldLengthText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                                <TextBlock Grid.Column="1" Text="см" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                            <CheckBox Content="Учитывать сварку" IsChecked="{Binding UseWelding}" FontWeight="Bold"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Row="2">
                    <Button Content="Рассчитать всё" Height="45" Command="{Binding CalculateCommand}" Background="#4CAF50" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ResultText}" FontSize="26" FontWeight="Bold" Margin="0,15,0,0" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ResultDetails}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0"/>

                    <!-- 🔍 Прозрачная детализация расчёта. По умолчанию свернута, чтобы не перегружать экран;
                         оператор может раскрыть и сверить каждый шаг с Excel-моделью цеха. -->
                    <Expander Header="🔍 Детализация расчёта"
                              IsExpanded="False"
                              Margin="0,10,0,0"
                              Visibility="{Binding HasBreakdowns, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Breakdowns}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="3"
                                            Margin="0,0,0,6" Padding="6" Background="#FAFAFA">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Section}" FontWeight="Bold" FontSize="12" Foreground="#1565C0"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="Gray"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Label}" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Formula}" FontSize="10" Foreground="Gray"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                       Margin="8,0,0,0" FontSize="11">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:N2} {1}">
                                                                        <Binding Path="Value"/>
                                                                        <Binding Path="Unit"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <TextBlock Text="{Binding ValidationMessage}" FontSize="12" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <GroupBox Grid.Column="1" Header="История расчётов / отчёт для руководства" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка фильтра: даты + быстрая кнопка «Текущий месяц» -->
                <Grid Grid.Row="0" Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Период:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker Grid.Column="1" Width="110" SelectedDate="{Binding FilterStart}"
                                ToolTip="Дата начала (включительно)"/>
                    <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker Grid.Column="3" Width="110" SelectedDate="{Binding FilterEnd}"
                                ToolTip="Дата окончания (включительно)"/>

                    <Button Grid.Column="4" Content="Текущий месяц" Margin="10,0,0,0" Padding="6,2"
                            Command="{Binding FilterCurrentMonthCommand}"
                            ToolTip="Установить период на текущий календарный месяц"/>

                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button Content="Применить" Padding="8,2" Margin="0,0,5,0"
                                Command="{Binding ApplyHistoryFilterCommand}"
                                Background="#C8E6C9"/>
                        <Button Content="Сброс" Padding="8,2"
                                Command="{Binding ResetHistoryFilterCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопка экспорта -->
                <Button Grid.Row="1" Content="📊 Скачать в Excel (отчёт для руководства)"
                        HorizontalAlignment="Right" Width="280" Height="25" Margin="0,5,5,5"
                        Command="{Binding ExportToExcelCommand}" Background="#E0F7FA"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <!-- ContextMenu находится вне логического дерева, поэтому используем PlacementTarget.
                                 Передаём выбранный элемент как параметр -->
                            <MenuItem Header="🗑 Удалить строку"
                                      Command="{Binding PlacementTarget.DataContext.DeleteOrderByParamCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="30"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=\{0:dd.MM HH:mm\}}" Width="90"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding OperationType}" Width="60" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Инфо" Binding="{Binding Description}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat=\{0:N0\} ₸}" Width="70" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- KPI-строка под таблицей: «N заказов на X ₸, средний чек …» -->
                <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                        Padding="8,4">
                    <TextBlock Text="{Binding HistorySummaryText}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
