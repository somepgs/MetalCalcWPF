<Window x:Class="MetalCalcWPF.DataEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:MetalCalcWPF.Models"
        xmlns:infra="clr-namespace:MetalCalcWPF.Infrastructure"
        Title="Редактор Базы Данных (Панель Технолога)" Height="700" Width="1150" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ObjectDataProvider x:Key="ProfileKindValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ProfileKind"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <infra:ProfileKindDisplayConverter x:Key="KindRu"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚠️ Будьте осторожны! Изменения влияют на все будущие расчеты."
                   Foreground="Red" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">

            <TabItem Header="🏗️ Материалы">
                <DataGrid ItemsSource="{Binding Materials}" AutoGenerateColumns="False" CanUserAddRows="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Плотность (г/см3)" Binding="{Binding Density}" Width="120"/>
                        <DataGridTextColumn Header="Базовая цена (тг/кг)" Binding="{Binding BasePricePerKg}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🔥 Лазер (Профили)">
                <DataGrid ItemsSource="{Binding LaserProfiles}" AutoGenerateColumns="False" CanUserAddRows="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Толщина" Binding="{Binding Thickness}" Width="80"/>
                        <DataGridTextColumn Header="Газ" Binding="{Binding GasType}" Width="80"/>
                        <DataGridTextColumn Header="Скорость (м/мин)" Binding="{Binding CuttingSpeed}" Width="120"/>
                        <DataGridTextColumn Header="Цена пробивки" Binding="{Binding PiercePrice}" Width="100"/>
                        <DataGridTextColumn Header="Коэфф. Наценки" Binding="{Binding MarkupCoefficient}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="📐 Гибка (Цены)">
                <DataGrid ItemsSource="{Binding BendingProfiles}" AutoGenerateColumns="False" CanUserAddRows="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Толщина" Binding="{Binding Thickness}" Width="70"/>
                        <DataGridTextColumn Header="Матрица V" Binding="{Binding V_Die}" Width="80"/>
                        <DataGridTextColumn Header="Мин. полка" Binding="{Binding MinFlange}" Width="80"/>

                        <DataGridTextColumn Header="Цена (&lt;1.5м)" Binding="{Binding PriceLen1500}" Width="100"/>
                        <DataGridTextColumn Header="Цена (&lt;3м)" Binding="{Binding PriceLen3000}" Width="100"/>
                        <DataGridTextColumn Header="Цена (&lt;6м)" Binding="{Binding PriceLen6000}" Width="100"/>

                        <DataGridTextColumn Header="Наладка" Binding="{Binding SetupPrice}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ✅ НОВАЯ ВКЛАДКА: СВАРКА -->
            <TabItem Header="🔗 Сварка (Профили)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E3F2FD" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📋 Справочник профилей сварки" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#1976D2">
                                • Катет шва определяется толщиной металла (обычно Катет = 0.7 × Толщина)
                                <LineBreak/>
                                • Скорость сварки уменьшается с увеличением катета
                                <LineBreak/>
                                • Себестоимость включает: проволоку + работу + газ CO₂ + расходники
                                <LineBreak/>
                                • Цена клиенту = Себестоимость × 3.0 (коэффициент наценки)
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding WeldingProfiles}" AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Катет (мм)" Binding="{Binding FilletSize}" Width="80"/>
                            <DataGridTextColumn Header="Скорость (см/мин)" Binding="{Binding WeldingSpeed}" Width="120"/>
                            <DataGridTextColumn Header="Вес шва (г/см)" Binding="{Binding WeightPerCm}" Width="110"/>
                            <DataGridTextColumn Header="Себестоимость (тг/см)" Binding="{Binding CostPerCm}" Width="140"/>
                            <DataGridTextColumn Header="Цена клиенту (тг/см)" Binding="{Binding PricePerCm}" Width="150"/>
                            <DataGridTextColumn Header="Коэфф. наценки" Binding="{Binding MarkupCoefficient}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ✅ НОВАЯ ВКЛАДКА: СОРТАМЕНТ ПРОКАТА -->
            <TabItem Header="🧱 Сортамент проката">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFF3E0" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="📋 Справочник проката: уголки, профтрубы, швеллеры, двутавры"
                                       FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#E65100">
                                • Масса 1 пог. м (кг/м) взята из ГОСТ-таблиц — основа расчёта веса заказа.
                                <LineBreak/>
                                • Цена = Длина × Масса_на_метр × Цена_материала × Наценка
                                (либо Цена_за_метр_override, если указана).
                                <LineBreak/>
                                • Флаги станков определяют, на каком оборудовании можно отрезать профиль.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Фильтр по типу:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="320"
                                  ItemsSource="{Binding KindFilters}"
                                  SelectedItem="{Binding SelectedKindFilter}"
                                  Margin="0,0,10,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource KindRu}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="➕ Добавить"
                                Command="{Binding AddRolledProfileCommand}"
                                Padding="10,3" Margin="0,0,6,0"/>
                        <Button Content="🗑 Удалить выделенный"
                                Command="{Binding DeleteRolledProfileCommand}"
                                CommandParameter="{Binding ElementName=RolledGrid, Path=SelectedItem}"
                                Padding="10,3"/>
                    </StackPanel>

                    <DataGrid x:Name="RolledGrid" Grid.Row="2"
                              ItemsSource="{Binding RolledProfilesView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Тип" Width="110"
                                                    ItemsSource="{Binding Source={StaticResource ProfileKindValues}}"
                                                    SelectedItemBinding="{Binding Kind}"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeCode}" Width="110"/>
                            <DataGridTextColumn Header="ГОСТ-обозначение" Binding="{Binding GostDesignation}" Width="240"/>
                            <DataGridTextColumn Header="кг/м" Binding="{Binding WeightPerMeterKg}" Width="70"/>
                            <DataGridTextColumn Header="H" Binding="{Binding Height}" Width="55"/>
                            <DataGridTextColumn Header="W" Binding="{Binding Width}" Width="55"/>
                            <DataGridTextColumn Header="t" Binding="{Binding WallThickness}" Width="55"/>
                            <DataGridTextColumn Header="Мат-л ID" Binding="{Binding MaterialTypeId}" Width="65"/>
                            <DataGridTextColumn Header="Цена/м (override)" Binding="{Binding PricePerMeterOverride}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Лазер"    Binding="{Binding CanLaser, UpdateSourceTrigger=PropertyChanged}"    Width="55"/>
                            <DataGridCheckBoxColumn Header="Пила"     Binding="{Binding CanBandSaw, UpdateSourceTrigger=PropertyChanged}"  Width="55"/>
                            <DataGridCheckBoxColumn Header="П.-нож."  Binding="{Binding CanPressShears, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Гильот."  Binding="{Binding CanGuillotine, UpdateSourceTrigger=PropertyChanged}"  Width="60"/>
                            <DataGridCheckBoxColumn Header="Болг."    Binding="{Binding CanAngleGrinder, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridCheckBoxColumn Header="Акт." Binding="{Binding IsActive}" Width="45"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <Button Grid.Row="2" Content="💾 Сохранить изменения в Базе" Height="40"
                Command="{Binding SaveCommand}" Background="#FFDDDDDD" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Window>
